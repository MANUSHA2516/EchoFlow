# EchoFlow local development — copy to .env and adjust. Never commit real secrets.

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/echoflow

# NestJS API
API_PORT=4000
API_HOST=0.0.0.0
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081,http://127.0.0.1:8081
ML_SERVICE_URL=http://127.0.0.1:8000
OTP_PROVIDER=console
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
PASSWORD_RESET_TTL_MINUTES=15
SESSION_IDLE_MINUTES=15

# Demo admin 2FA (development only — replace in production)
ADMIN_TOTP_DEMO_SECRET=JBSWY3DPEHPK3PXP

# Patient app (Expo / React Native)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:4000
EXPO_PUBLIC_FORCE_DEMO=true
PATIENT_APP_PORT=3000

# Frontends (staff/admin Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_APP_BRAND=EchoFlow

# Staff app
STAFF_APP_PORT=3001

# Admin app
ADMIN_APP_PORT=3002

# ML service
ML_PORT=8000
ML_MODEL_DIR=./artifacts
ML_DATA_PROVENANCE=synthetic
